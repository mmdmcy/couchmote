# CouchMote is tailnet-only by default. Use loopback for local setup/testing.
COUCHMOTE_LISTEN=tailnet
COUCHMOTE_PORT=8791

# The default resolves the Firefox executable from PATH.
COUCHMOTE_BROWSER=firefox

# Optional overrides. Defaults live under XDG state directories.
# COUCHMOTE_STATE_DIR=/home/you/.local/state/couchmote
# COUCHMOTE_PROFILE_DIR=/home/you/.local/state/couchmote/firefox-profile

# The service requires an active X11 desktop session for the visible TV browser.
# DISPLAY=:0
# XAUTHORITY=/home/you/.Xauthority
